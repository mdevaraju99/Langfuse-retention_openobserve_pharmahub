# API Keys (Optional - for higher rate limits)
# Get free API keys from:
# NewsAPI: https://newsapi.org/register
# OpenFDA: https://open.fda.gov/apis/authentication/
# Groq: https://console.groq.com/

NEWSAPI_KEY=your_newsapi_key_here
OPENFDA_KEY=your_openfda_key_here
GROQ_API_KEY=your_groq_api_key_here

# Neo4j (Company Knowledge / RAG graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
# Must match the vector index name created in Neo4j (default: chunk_embeddings)
# NEO4J_VECTOR_INDEX_NAME=chunk_embeddings

# RAG ingestion / UX toggles (optional)
# RAG_MAX_PDF_MB=80
# RAG_MAX_PDF_PAGES=250
# RAG_MAX_CHUNKS_PER_DOC=400
# RAG_MAX_INGEST_CHARS=2000000
# ENABLE_STREAMING_UI=true
# ENABLE_AGENTIC_RAG_DEFAULT=true
# ENABLE_ANSWER_VALIDATION=true
# RAG_CONFIDENCE_THRESHOLD=55
# RAG_STRICT_ABSTAIN_ON_FAIL=true
# RAG_MAX_REVISION_ROUNDS=1
# RAG_CLARIFIER_MIN_CHARS=12
# BENCHMARK_OUTPUT_DIR=data/benchmarks

# Release quality gates (optional)
# QUALITY_MIN_CASE_PASS_RATE=0.70
# QUALITY_MAX_RETRIEVAL_P95_MS=3000
# QUALITY_MIN_VALIDATION_CONFIDENCE=55

# Rich-media extraction / preview artifacts
# MEDIA_ASSETS_DIR=data/media_assets
# RAG_MAX_MEDIA_IMAGES=24
# RAG_MAX_MEDIA_TABLE_PREVIEWS=12
# RAG_MAX_MEDIA_SNIPPETS=12
