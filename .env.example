# API Keys (Optional - for higher rate limits)
# Get free API keys from:
# NewsAPI: https://newsapi.org/register
# OpenFDA: https://open.fda.gov/apis/authentication/
# Groq: https://console.groq.com/

NEWSAPI_KEY=your_newsapi_key_here
OPENFDA_KEY=your_openfda_key_here
GROQ_API_KEY=your_groq_api_key_here

# Neo4j (Company Knowledge / RAG graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
# Must match the vector index name created in Neo4j (default: chunk_embeddings)
# NEO4J_VECTOR_INDEX_NAME=chunk_embeddings

# RAG ingestion / UX toggles (optional)
# RAG_MAX_PDF_MB=80
# RAG_MAX_PDF_PAGES=250
# RAG_MAX_CHUNKS_PER_DOC=400
# RAG_MAX_INGEST_CHARS=2000000
# ENABLE_STREAMING_UI=true
# ENABLE_AGENTIC_RAG_DEFAULT=true
# ENABLE_ANSWER_VALIDATION=true
# RAG_CONFIDENCE_THRESHOLD=55
# RAG_STRICT_ABSTAIN_ON_FAIL=true
# RAG_MAX_REVISION_ROUNDS=1
# RAG_CLARIFIER_MIN_CHARS=12
# BENCHMARK_OUTPUT_DIR=data/benchmarks

# Release quality gates (optional)
# QUALITY_MIN_CASE_PASS_RATE=0.70
# QUALITY_MAX_RETRIEVAL_P95_MS=3000
# QUALITY_MIN_VALIDATION_CONFIDENCE=55

# Rich-media extraction / preview artifacts
# MEDIA_ASSETS_DIR=data/media_assets
# RAG_MAX_MEDIA_IMAGES=24
# RAG_MAX_MEDIA_TABLE_PREVIEWS=12
# RAG_MAX_MEDIA_SNIPPETS=12

# Pharma News query behavior (optional)
# PHARMA_NEWS_DEFAULT_QUERY=pharmaceutical drug
# PHARMA_NEWS_CONTEXT_QUERY=pharmaceutical OR pharma OR biotech OR drug OR FDA OR vaccine OR medicine OR healthcare OR oncology OR clinical trial OR therapy OR treatment OR patient

# Global pharma guardrail (sidebar defaults to ENABLE_PHARMA_GUARDRAIL; post-filters NewsAPI articles; enriches PubMed / ClinicalTrials queries)
# ENABLE_PHARMA_GUARDRAIL=true
# Comma-separated tokens matched in title+description (word boundaries for single tokens)
# PHARMA_RELEVANCE_KEYWORDS=pharmaceutical,pharma,biotech,drug,fda,vaccine,medicine,healthcare,oncology,clinical trial,therapy,treatment,patient,clinical,therapeutic,prescription,lifesciences,life sciences,regulatory,ema,biologic,antibody,pharmacology,medication,hospital,physician,diagnosis,genomic,molecule,placebo
# PUBMED_GUARDRAIL_APPEND=(pharmaceutical OR pharma OR biotech OR drug OR medicine OR clinical OR patient OR therapy OR treatment OR vaccine OR FDA OR healthcare OR oncology OR pharmacology OR medical)
# CLINICAL_TRIALS_GUARDRAIL_APPEND=(drug OR pharmaceutical OR pharma OR biotech OR vaccine OR therapy OR medicine OR clinical OR device OR patient OR treatment)
# Require typed searches to include pharma/clinical vocabulary when guardrail is on (blocks e.g. "engineer")
# REQUIRE_PHARMA_INTENT_IN_USER_QUERY=true
# Extra comma-separated tokens for user-query intent (merged with relevance keywords + companies + drug synonyms)
# PHARMA_USER_QUERY_LEXICON=cancer,diabetes,FDA,...

# Chatbot domain policy (optional)
# CHATBOT_ENFORCE_DOMAIN_ONLY=true
# CHATBOT_DOMAIN_REFUSAL_TEXT=Please ask pharmaceutical-domain questions (drugs, trials, biotech, regulatory, healthcare research).

# Hybrid retrieval fallback seeds (comma separated, optional)
# RAG_HYBRID_FALLBACK_KEYWORDS=primary endpoint,CDR-SB,ADAS-Cog,ARIA-E,ARIA-H,mechanism,amyloid,antibody,efficacy,safety,adverse,dose,administration,dosing,protocol,baseline,Week 72,results,outcome

# Events filtering/query behavior (optional)
# EVENT_MIN_SCORE=15
# EVENT_ACTION_KEYWORDS=register,registration,deadline,apply,submit,join us,attend,participate,enroll,spots available,virtual event,in-person event,hybrid event
# EVENT_DATE_KEYWORDS=scheduled for,taking place,to be held,dates announced,event date,happening on,2026,2027
# EVENT_EXCLUSION_KEYWORDS=market report,market analysis,stock,shares,earnings,quarterly report,revenue,profit,financial results,crime,police,lawsuit,litigation,cagr,forecast,market size,merger,acquisition,dividend,price target
# EVENT_PHARMA_KEYWORDS=pharmaceutical,pharma,biotech,drug,clinical,fda,regulatory,medicine,therapy,healthcare,life sciences
# EVENT_QUERY_HACKATHON=(hackathon OR "coding competition" OR "innovation challenge" OR datathon) AND ("pharmaceutical" OR "biotech" OR "healthcare" OR "drug discovery")
# EVENT_QUERY_CONFERENCE=(conference OR summit OR congress OR symposium) AND ("pharmaceutical" OR "biotech" OR "clinical trials") AND (2026 OR 2027)
# EVENT_QUERY_WORKSHOP=(workshop OR webinar OR training OR "certification course") AND (FDA OR "regulatory affairs" OR "clinical trials" OR GMP)
# EVENT_STRONG_KEYWORDS_JSON={"hackathon":["hackathon","hack-a-thon","coding competition","coding challenge","innovation challenge","dev challenge","datathon"],"conference":["conference","summit","symposium","congress","expo","forum","annual meeting","world congress","international conference"],"workshop":["workshop","webinar","training session","masterclass","bootcamp","short course","hands-on training","certification course"]}

# Company News quick buttons (optional)
# COMPANY_NEWS_QUICK_ACCESS=Pfizer,Moderna,Johnson & Johnson,AstraZeneca,Dr. Reddy's Laboratories,Sun Pharma

# Drug search synonym groups (JSON array of string arrays), optional
# DRUG_NAME_SYNONYM_GROUPS_JSON=[["paracetamol","acetaminophen"],["epinephrine","adrenaline"]]
